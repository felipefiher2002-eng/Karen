}

.galeria img{
 width:45%;
 border-radius:20px;
}

.carta{
 line-height:1.7;
 font-size:18px;
}

.estrella{
 position:fixed;
 width:5px;
 height:5px;
 background:white;
 border-radius:50%;
 animation:caer linear infinite;
}

@keyframes caer{
from{transform:translateY(-20px);}
to{transform:translateY(100vh);}
}

</style>

</head>

