/* ===========================
   FELIPE ❤️ KAREN
=========================== */

*{
margin:0;
padding:0;
box-sizing:border-box;
}

html{
scroll-behavior:smooth;
}

body{

font-family:'Poppins',sans-serif;

background:#090909;

color:white;

overflow-x:hidden;

}

/* Fondo */

body::before{

content:"";

position:fixed;

top:0;

left:0;

width:100%;

height:100%;

background:
radial-gradient(circle at top,#3a001d,#090909 65%);

z-index:-3;

}

/* Estrellas */

.stars{

position:fixed;

top:0;

left:0;

width:100%;

height:100%;

pointer-events:none;

background-image:

radial-gradient(white 1px,transparent 1px),

radial-gradient(white 1px,transparent 1px),

radial-gradient(#ffd6e7 1px,transparent 1px);

background-size:

120px 120px,

180px 180px,

260px 260px;

opacity:.45;

animation:starsMove 80s linear infinite;

z-index:-2;

}

@keyframes starsMove{

from{

transform:translateY(0);

}

to{

transform:translateY(-400px);

}

}

section{

padding:90px 22px;

max-width:1100px;

margin:auto;

}

/* Pantalla principal */

#intro{

min-height:100vh;

display:flex;

justify-content:center;

align-items:center;

text-align:center;

position:relative;

}

.title{

font-family:'Great Vibes',cursive;

font-size:72px;

color:white;

margin-bottom:20px;

text-shadow:

0 0 15px rgba(255,255,255,.3),

0 0 40px #ff2d75;

}

.subtitle{

max-width:700px;

margin:auto;

font-size:20px;

line-height:1.8;

opacity:.9;

}

#enterButton{

margin-top:45px;

padding:18px 40px;

font-size:20px;

border:none;

border-radius:60px;

background:#ff2d75;

color:white;

cursor:pointer;

transition:.35s;

box-shadow:

0 0 20px rgba(255,45,117,.5);

}

#enterButton:hover{

transform:scale(1.08);

background:#ff5d95;

}
/* ===========================
   CONTADOR
=========================== */

.contador{

text-align:center;

}

.contador h2{

font-size:42px;

margin-bottom:25px;

font-family:'Great Vibes',cursive;

color:#ffd3df;

}

#contador{

display:inline-block;

margin:30px auto;

padding:25px 40px;

border-radius:25px;

background:rgba(255,255,255,.08);

backdrop-filter:blur(12px);

border:1px solid rgba(255,255,255,.15);

font-size:34px;

font-weight:700;

color:white;

box-shadow:

0 10px 40px rgba(255,45,117,.25);

}

.contador p{

margin-top:20px;

font-size:18px;

opacity:.85;

}

/* ===========================
   TIMELINE
=========================== */

.timeline{

margin-top:100px;

}

.timeline h2{

text-align:center;

font-size:46px;

font-family:'Great Vibes',cursive;

margin-bottom:45px;

color:#ff7da8;

}

.timeline-card{

background:rgba(255,255,255,.06);

backdrop-filter:blur(14px);

border-radius:25px;

padding:30px;

margin-bottom:25px;

border:1px solid rgba(255,255,255,.08);

transition:.35s;

}

.timeline-card:hover{

transform:translateY(-8px);

box-shadow:0 20px 45px rgba(255,45,117,.18);

}

.timeline-card h3{

margin-bottom:15px;

font-size:28px;

color:#ffd3df;

}

.timeline-card p{

font-size:18px;

line-height:1.8;

opacity:.9;

}

/* ===========================
   GALERÍA
=========================== */

.gallery{

margin-top:100px;

text-align:center;

}

.gallery h2{

font-size:48px;

font-family:'Great Vibes',cursive;

color:#ff7da8;

margin-bottom:20px;

}

.gallery-text{

opacity:.8;

margin-bottom:35px;

font-size:18px;

}

.gallery-grid{

display:grid;

grid-template-columns:repeat(auto-fit,minmax(220px,1fr));

gap:20px;

}

.gallery-grid img{

width:100%;

height:300px;

object-fit:cover;

border-radius:20px;

transition:.35s;

cursor:pointer;

box-shadow:0 10px 30px rgba(0,0,0,.35);

}

.gallery-grid img:hover{

transform:scale(1.05);

box-shadow:0 20px 40px rgba(255,45,117,.30);

}
/*=========================
SOBRE
==========================*/

.envelope-container{

display:flex;

flex-direction:column;

justify-content:center;

align-items:center;

height:100vh;

}

.envelope{

position:relative;

width:320px;

height:220px;

cursor:pointer;

transition:.8s;

}

.front{

position:absolute;

width:100%;

height:100%;

background:#ff5d8f;

clip-path:polygon(0 0,100% 0,100% 100%,0 100%);

border-radius:10px;

box-shadow:0 20px 50px rgba(0,0,0,.35);

}

.letter{

position:absolute;

left:15px;

right:15px;

top:15px;

bottom:15px;

background:white;

color:#333;

border-radius:8px;

padding:20px;

display:flex;

flex-direction:column;

justify-content:center;

align-items:center;

text-align:center;

transition:.8s;

transform:translateY(20px);

}

.letter h2{

font-family:'Great Vibes',cursive;

font-size:42px;

color:#ff2d75;

margin-bottom:15px;

}

.seal{

position:absolute;

left:50%;

top:50%;

transform:translate(-50%,-50%);

width:60px;

height:60px;

border-radius:50%;

background:#d1004b;

display:flex;

justify-content:center;

align-items:center;

font-size:28px;

z-index:5;

box-shadow:0 0 25px rgba(255,0,80,.5);

}

.tap-text{

margin-top:40px;

opacity:.8;

font-size:18px;

animation:parpadeo 2s infinite;

}

@keyframes parpadeo{

50%{

opacity:.3;

}

}
/* ===========================
   CARTA
=========================== */

.letter{

padding:100px 25px;

}

.letter h2{

font-family:'Great Vibes',cursive;

font-size:55px;

text-align:center;

margin-bottom:45px;

color:#ff8fb5;

}

.letter-content{

max-width:900px;

margin:auto;

padding:45px;

background:rgba(255,255,255,.08);

border-radius:30px;

backdrop-filter:blur(18px);

border:1px solid rgba(255,255,255,.12);

box-shadow:0 20px 50px rgba(0,0,0,.25);

}

.letter-content p{

font-size:20px;

line-height:2;

margin-bottom:22px;

color:#f3f3f3;

}

.firma{

text-align:right;

font-size:26px;

font-family:'Great Vibes',cursive;

color:#ffd2e1;

margin-top:50px;

}

/* ===========================
   FINAL
=========================== */

.final-message{

text-align:center;

padding:120px 25px;

}

.final-message h2{

font-size:58px;

font-family:'Great Vibes',cursive;

margin-bottom:35px;

color:#ff7ca8;

}

.final-message h3{

font-size:52px;

margin-top:50px;

margin-bottom:30px;

font-family:'Great Vibes',cursive;

color:white;

animation:pulse 2.5s infinite;

}

.final-message p{

max-width:900px;

margin:auto;

line-height:2;

font-size:20px;

margin-bottom:25px;

}

footer{

padding:60px;

text-align:center;

opacity:.75;

font-size:18px;

}

@keyframes pulse{

0%{transform:scale(1);}

50%{transform:scale(1.08);}

100%{transform:scale(1);}

}